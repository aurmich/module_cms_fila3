@push('styles')
<style>
    /* Custom wizard styling for better UX */
    .filament-wizard .filament-wizard-header {
        @apply hidden; /* Nascondiamo l'header default per usare il nostro progress indicator */
    }
    
    .filament-wizard .filament-wizard-step {
        @apply transition-all duration-500 ease-in-out;
    }
    
    /* Enhanced form styling */
    .prose .filament-forms-field-wrapper {
        @apply mb-6;
    }
    
    /* Loading animation enhancement */
    @keyframes gentle-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.8; }
    }
    
    .loading-gentle-pulse {
        animation: gentle-pulse 2s ease-in-out infinite;
    }
    
    /* Responsive improvements */
    @media (max-width: 640px) {
        .progress-step-text {
            @apply hidden;
        }
    }
</style>
@endpush

@push('scripts')
<script>
    document.addEventListener('livewire:initialized', () => {
        // Enhanced wizard step tracking
        let currentWizardStep = 0;
        
        // Listen for wizard navigation
        Livewire.on('wizard-step-changed', (data) => {
            currentWizardStep = data.step || 0;
            window.dispatchEvent(new CustomEvent('wizard-step-updated', { 
                detail: { step: currentWizardStep } 
            }));
        });
        
        // Auto-scroll to form on step change (mobile optimization)
        Livewire.on('wizard-step-changed', () => {
            if (window.innerWidth < 768) {
                document.querySelector('.filament-wizard')?.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'start' 
                });
            }
        });
        
        // Enhanced error handling
        Livewire.on('form-error', (data) => {
            // Auto-scroll to error
            const firstError = document.querySelector('.filament-forms-field-wrapper--error');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
        
        // Accessibility enhancements
        document.addEventListener('keydown', (e) => {
            // ESC key to close loading overlays
            if (e.key === 'Escape') {
                const loadingOverlay = document.querySelector('[wire\\:loading]');
                if (loadingOverlay && loadingOverlay.style.display !== 'none') {
                    // Let user know they can't cancel during processing
                    console.log('Processing cannot be cancelled');
                }
            }
        });
        
        // Form validation enhancement
        const form = document.querySelector('form[wire\\:submit\\.prevent="submit"]');
        if (form) {
            form.addEventListener('submit', (e) => {
                // Add visual feedback
                const submitButton = form.querySelector('[type="submit"]');
                if (submitButton) {
                    submitButton.classList.add('loading-gentle-pulse');
                }
            });
        }
    });
</script>
@endpush
