## Sicurezza e Controlli Accesso

### Middleware EnsureUserType
```php
class EnsureUserType
{
    public function handle(Request $request, Closure $next, string $userType): Response
    {
        if (!auth()->check()) {
            abort(401);
        }

        if (auth()->user()->type->value !== $userType) {
            abort(403, 'Accesso negato per questo tipo di utente');
        }

        return $next($request);
    }
}
```

### Policy AppointmentPolicy
```php
class AppointmentPolicy
{
    public function viewAny(User $user): bool
    {
        return match ($user->type) {
            UserType::ADMIN => true,
            UserType::DOCTOR => true,
            UserType::PATIENT => true,
            default => false,
        };
    }

    public function view(User $user, Appointment $appointment): bool
    {
        return match ($user->type) {
            UserType::ADMIN => true,
            UserType::DOCTOR => $appointment->doctor_id === $user->id ||
                               ($user->hasRole('studio_admin') &&
                                $appointment->studio_id === $user->studio_id),
            UserType::PATIENT => $appointment->patient_id === $user->id,
            default => false,
        };
    }

    public function create(User $user): bool
    {
        return match ($user->type) {
            UserType::ADMIN => true,
            UserType::DOCTOR => true,
            UserType::PATIENT => false,
            default => false,
        };
    }

    public function update(User $user, Appointment $appointment): bool
    {
        return match ($user->type) {
            UserType::ADMIN => true,
            UserType::DOCTOR => $appointment->doctor_id === $user->id ||
                               ($user->hasRole('studio_admin') &&
                                $appointment->studio_id === $user->studio_id),
            UserType::PATIENT => false,
            default => false,
        };
    }
}
```

