### 6. Migrazione Enum

#### Creazione Enum
```php
// ✅ NUOVO: UserType Enum
enum UserType: string implements HasLabel
{
    case ADMIN = 'admin';
    case DOCTOR = 'doctor';
    case PATIENT = 'patient';

    public function getLabel(): string
    {
        return match ($this) {
            self::ADMIN => 'Amministratore',
            self::DOCTOR => 'Dottore',
            self::PATIENT => 'Paziente',
        };
    }
}

// ✅ NUOVO: AppointmentType Enum
enum AppointmentType: string implements HasLabel, HasColor
{
    case CONSULTATION = 'consultation';
    case CLEANING = 'cleaning';
    case TREATMENT = 'treatment';
    case EMERGENCY = 'emergency';

    public function getColor(): string
    {
        return match ($this) {
            self::CONSULTATION => '#3B82F6',
            self::CLEANING => '#10B981',
            self::TREATMENT => '#F59E0B',
            self::EMERGENCY => '#EF4444',
        };
    }
}
```

## 🔧 Configurazione Trait

### HasFullCalendarConfig
```php
// ✅ NUOVO: Trait per Configurazioni Comuni
trait HasFullCalendarConfig
{
    public function config(): array
    {
        $baseConfig = [
            'locale' => 'it',
            'timezone' => 'Europe/Rome',
            'firstDay' => 1,
            'businessHours' => config('fullcalendar.businessHours'),
        ];

        return $this->mergeConfigs($baseConfig, $this->getWidgetSpecificConfig());
    }

    protected function getAppointmentStatusColor(string $status): string
    {
        return config("fullcalendar.colors.appointment_status.{$status}", '#3B82F6');
    }

    protected function formatEventTitle(object $appointment): string
    {
        if (config('fullcalendar.security.mask_patient_names') &&
            !$this->canViewPatientNames()) {
            return "Appuntamento - {$appointment->type->getLabel()}";
        }

        return "{$appointment->patient->full_name} - {$appointment->type->getLabel()}";
    }
}
```

## 🛡️ Sicurezza e Middleware

### EnsureUserType Middleware
```php
// ✅ NUOVO: Middleware per Controllo Tipo Utente
class EnsureUserType
{
    public function handle(Request $request, Closure $next, string $type): Response
    {
        if (!auth()->check()) {
            return redirect()->route('login');
        }

        $user = auth()->user();
        $expectedType = UserType::from($type);

        if ($user->type !== $expectedType) {
            abort(403, "Accesso negato. Richiesto tipo utente: {$expectedType->getLabel()}");
        }

        return $next($request);
    }
}
```

### Policy Aggiornate
```php
// ✅ NUOVO: AppointmentPolicy con Parental STI
class AppointmentPolicy
{
    public function viewAny(User $user): bool
    {
        return match ($user->type) {
            UserType::PATIENT => true, // Solo propri
            UserType::DOCTOR => Filament::getTenant() !== null,
            UserType::ADMIN => true,
        };
    }

    public function view(User $user, Appointment $appointment): bool
    {
        return match ($user->type) {
            UserType::PATIENT => $appointment->patient_id === $user->id,
            UserType::DOCTOR => $appointment->studio_id === Filament::getTenant()?->id,
            UserType::ADMIN => true,
        };
    }
}
```

## 🧪 Testing Aggiornato

### Test con Parental STI
```php
// ✅ NUOVO: Test con Tipi Utente
class PatientCalendarWidgetTest extends TestCase
{
    public function test_patient_can_view_only_own_appointments(): void
    {
        $patient = Patient::factory()->create();
        $otherPatient = Patient::factory()->create();

        $myAppointment = Appointment::factory()->create(['patient_id' => $patient->id]);
        $otherAppointment = Appointment::factory()->create(['patient_id' => $otherPatient->id]);

        $this->actingAs($patient);

        $widget = new PatientCalendarWidget();
        $events = $widget->fetchEvents([
            'start' => now()->startOfMonth()->toISOString(),
            'end' => now()->endOfMonth()->toISOString(),
        ]);

        $this->assertCount(1, $events);
        $this->assertEquals($myAppointment->id, $events[0]['id']);
    }

    public function test_doctor_can_view_studio_appointments(): void
    {
        $studio = Studio::factory()->create();
        $doctor = Doctor::factory()->create(['studio_id' => $studio->id]);

        Filament::setTenant($studio);

        $appointment = Appointment::factory()->create([
            'studio_id' => $studio->id,
            'doctor_id' => $doctor->id,
        ]);

        $this->actingAs($doctor);

        $widget = new DoctorCalendarWidget();
        $events = $widget->fetchEvents([
            'start' => now()->startOfMonth()->toISOString(),
            'end' => now()->endOfMonth()->toISOString(),
        ]);

        $this->assertCount(1, $events);
        $this->assertEquals($appointment->id, $events[0]['id']);
    }
}
```

