<?php

declare(strict_types=1);

use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Facades\DB;
use Modules\Xot\Database\Migrations\XotBaseMigration;

return new class extends XotBaseMigration
{
    /**
     * Nome della tabella.
     */
    protected string $table_name = 'users';

    /**
     * Aggiorna la tabella users per impostare il default del campo type
     * e aggiornare i record esistenti con type null.
     */
    public function up(): void
    {
        // Verifica se la tabella esiste
        if (!Schema::hasTable($this->table_name)) {
            echo 'Tabella ['.$this->table_name.'] non esistente';
            return;
        }

        // Verifica se la colonna type esiste
        if (!Schema::hasColumn($this->table_name, 'type')) {
            echo 'Colonna [type] non esistente nella tabella ['.$this->table_name.']';
            return;
        }

        // Aggiorna tutti i record con type null al valore di default 'patient'
        DB::table($this->table_name)
            ->whereNull('type')
            ->update(['type' => 'patient']);

        echo 'Record con type null aggiornati a "patient"';

        // Modifica la colonna per impostare il default value
        Schema::table($this->table_name, function (Blueprint $table) {
            $table->string('type')->default('patient')->change();
        });

        echo 'Colonna [type] aggiornata con default "patient"';
    }
}; 