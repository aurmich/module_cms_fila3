<?php

declare(strict_types=1);

namespace Modules\SaluteOra\Actions\Patient\Calendar;

use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Collection;
use Spatie\QueueableAction\QueueableAction;
use Modules\SaluteOra\Enums\UserTypeEnum;
use Modules\SaluteOra\Enums\AppointmentStatusEnum;
use Modules\SaluteOra\Enums\AppointmentTypeEnum;
use Modules\SaluteOra\Models\Appointment;

/**
 * Fetches and formats calendar events for a patient
 */
final class FetchEventsAction
{
    use QueueableAction;

    /**
     * Fetches events for the authenticated patient
     *
     * @param array $fetchInfo Must contain 'start' and 'end' (ISO8601 strings)
     * @return array
     */
    public function execute(array $fetchInfo): array
    {
        try {
            $user = Auth::user();

            if (!$user || $user->type !== UserTypeEnum::PATIENT) {
                throw new \RuntimeException('Unauthorized: User is not a patient');
            }

            if (empty($fetchInfo['start']) || empty($fetchInfo['end'])) {
                throw new \InvalidArgumentException('Missing required date range parameters');
            }

            return $this->fetchEvents($user->id, $fetchInfo['start'], $fetchInfo['end'])
                ->toArray();

        } catch (\Throwable $e) {
            Log::error('Failed to fetch calendar events', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
                'user_id' => $user->id ?? null,
            ]);

            return [];
        }
    }

    /**
     * Fetches events from the database
     */
    private function fetchEvents(int $userId, string $start, string $end): Collection
    {
        return Appointment::query()
            ->with(['doctor', 'studio'])
            ->where('patient_id', $userId)
            ->whereBetween('starts_at', [$start, $end])
            ->orderBy('starts_at')
            ->limit(500)
            ->get()
            ->map(fn ($appointment) => $this->transformAppointment($appointment));
    }

    /**
     * Transforms an appointment into a FullCalendar event format
     *
     * @param Appointment $appointment
     * @return array
     */
    private function transformAppointment(Appointment $appointment): array
    {
        $title = $this->formatEventTitle($appointment);
        $color = $this->getEventColor($appointment);
        return [
            'id' => $appointment->id,
            'title' => $title,
            'start' => $appointment->starts_at->toIso8601String(),
            'end' => $appointment->ends_at->toIso8601String(),
            'allDay' => false,
            'backgroundColor' => $color,
            'borderColor' => $color,
            'textColor' => $this->getContrastColor($color),
            'extendedProps' => [
                'type' => $appointment->type->value,
                'status' => $appointment->status->value,
                'doctor_name' => $appointment->doctor->full_name,
                'studio_name' => $appointment->studio->name,
                'emergency' => $appointment->emergency,
                'notes' => $appointment->notes,
            ],
            'editable' => false,
        ];
    }

    /**
     * Formatta il titolo dell'evento.
     *
     * @param Appointment $appointment
     * @return string
     */
    private function formatEventTitle(Appointment $appointment): string
    {
        $parts = [];
        if ($appointment->type) {
            $parts[] = $appointment->type->getLabel();
        }
        if ($appointment->doctor) {
            $parts[] = 'Dr. ' . $appointment->doctor->full_name;
        }
        if ($appointment->emergency) {
            $parts[] = '🚨 ' . __('saluteora::app.emergency');
        }
        if ($appointment->status && !$appointment->status->isActive()) {
            $parts[] = '(' . $appointment->status->getLabel() . ')';
        }
        return implode(' • ', $parts);
    }

    /**
     * Colore evento in base al tipo/appuntamento.
     *
     * @param Appointment $appointment
     * @return string
     */
    private function getEventColor(Appointment $appointment): string
    {
        if ($appointment->emergency) {
            return '#dc3545';
        }
        return match ($appointment->type) {
            AppointmentTypeEnum::CONSULTATION => '#fd7e14',
            AppointmentTypeEnum::CLEANING, AppointmentTypeEnum::PREVENTION => '#17a2b8',
            AppointmentTypeEnum::TREATMENT => '#28a745',
            AppointmentTypeEnum::EMERGENCY => '#dc3545',
            AppointmentTypeEnum::FOLLOWUP => '#ffc107',
            AppointmentTypeEnum::SURGERY, AppointmentTypeEnum::ORTHODONTICS => '#6f42c1',
            default => '#3490dc',
        };
    }

    /**
     * Contrasto testo per colore di background.
     *
     * @param string $hexColor
     * @return string
     */
    private function getContrastColor(string $hexColor): string
    {
        $hexColor = ltrim($hexColor, '#');
        $r = hexdec(substr($hexColor, 0, 2));
        $g = hexdec(substr($hexColor, 2, 2));
        $b = hexdec(substr($hexColor, 4, 2));
        $luminance = (0.299 * $r + 0.587 * $g + 0.114 * $b) / 255;
        return $luminance > 0.5 ? '#000000' : '#ffffff';
    }

    /**
     * Tag per Horizon/monitoraggio (opzionale).
     *
     * @return array<int, string>
     */
    public function tags(): array
    {
        return ['patient_calendar', 'fetch_events'];
    }
}
