    /**
     * Get the search step form schema.
     *
     * @return array<string, \Filament\Forms\Components\Select>
     */
    protected function getSeachStepSchema(): array
    {

        return [
            'region' => Select::make('region')
                ->options(function () {
                    return Comune::select('regione')
                    ->distinct()
                    ->orderBy('regione->nome')
                    ->get()
                    ->pluck('regione.nome','regione.codice')

                    ->toArray();
                })
                ->searchable()
                ->required()
                ->live()
                ->afterStateUpdated(function (Set $set){
                    $set('province', null);
                    $set('cap', null);
                })
                ,
            'province' => Select::make('province')
                ->options(function (Get $get) {
                    $region = $get('region');
                    if (!$region) {
                        return [];
                    }
                    $res= Comune::query()
                        ->where('regione->codice', $region)
                        ->select('provincia')
                        ->distinct()
                        ->orderBy('provincia->nome')
                        ->get()
                        ->pluck('provincia.nome', 'provincia.codice')
                        ->toArray();
                    return $res;
                })
                ->searchable()
                ->required()
                ->live()
                ->afterStateUpdated(fn (Set $set) => $set('cap', null))
                ,

            'cap' => Select::make('cap')
                ->options(function (Get $get) {
                    $region = $get('region');
                    if (!$region) {
                        return [];
                    }
                    $province = $get('province');
                    if (!$province) {
                        return [];
                    }
                    $res=Comune::query()
                        ->where('regione->codice', $region)
                        ->where('provincia->codice', $province)
                        ->select('cap')
                        ->distinct()
                        ->orderBy('cap')
                        ->get()
                        ->pluck('cap.0', 'cap.0')
                        ->toArray();

                    return $res;
                })
                ->searchable()
                ->required()
                ->live()
                ->disabled(fn (Get $get) => !$get('region') || !$get('province')),
        ];
    }

    protected function getStudioStepSchema(): array
    {
        return [
            \Modules\SaluteOra\Filament\Forms\Components\StudioSelectorButtons::make('studio_selection')
                ->sectionTitle(__('saluteora::widgets.find_doctor_and_appointment.studio_list.title'))
                ->studios(fn (Get $get) => $this->getStudiosForLocationFull($get))
                ->populatesStudioField('studio_id')
                ->populatesDoctorField('doctor_id')
                ->emptyStateTitle(__('saluteora::widgets.find_doctor_and_appointment.studio_list.empty_state.title'))
                ->emptyStateDescription(__('saluteora::widgets.find_doctor_and_appointment.studio_list.empty_state.description'))
                ->required()
                ->columnSpanFull(),
                
            Hidden::make('studio_id')->required(),
            Hidden::make('doctor_id')->required(),
        ];
    }

    /**
     * Get full studio objects for the selected location (for card display).
     *
     * @param \Filament\Forms\Get $get
     * @return \Illuminate\Database\Eloquent\Collection<int, \Modules\SaluteOra\Models\Studio>
     */
    private function getStudiosForLocationFull(Get $get): \Illuminate\Database\Eloquent\Collection
    {
        $cap = $get('cap');
        $province = $get('province'); 
        $region = $get('region');
        
        // Return empty collection if location data is incomplete
        if (!$cap || !$province || !$region) {
            Log::info('Missing location data', ['cap' => $cap, 'province' => $province, 'region' => $region]);
            return new \Illuminate\Database\Eloquent\Collection();
        }
        
        // DEBUG: Verifichiamo se ci sono studi nel database
        $totalStudios = \Modules\SaluteOra\Models\Studio::count();
        $activeStudios = \Modules\SaluteOra\Models\Studio::where('active', true)->count();
        $studiosWithAddress = \Modules\SaluteOra\Models\Studio::whereHas('address')->count();
        
        Log::info('Studio database stats', [
            'total_studios' => $totalStudios,
            'active_studios' => $activeStudios,
            'studios_with_address' => $studiosWithAddress
        ]);
        
        try {
            // Prima prova: query con filtri geografici specifici
            $studios = \Modules\SaluteOra\Models\Studio::whereHas('address', function($q) use ($cap, $province, $region) {
                $q->where('postal_code', $cap);
                // Ripristiniamo i filtri geografici se i campi esistono nella tabella addresses
                // ->where('administrative_area_level_3', $province)
                // ->where('administrative_area_level_2', $region);
            })
            ->where('active', true)
            ->with(['address', 'doctors']) // Carica SEMPRE la relazione doctors
            ->get();
            
            // Se non troviamo studi con i filtri specifici, proviamo solo con il CAP
            if ($studios->isEmpty()) {
                Log::info('No studios found with specific filters, trying CAP only');
                $studios = \Modules\SaluteOra\Models\Studio::whereHas('address', function($q) use ($cap) {
                    $q->where('postal_code', $cap);
                })
                ->where('active', true)
                ->with(['address', 'doctors'])
                ->get();
            }
            
            // Se ancora non troviamo studi, proviamo tutti gli studi attivi (per debug)
            if ($studios->isEmpty()) {
                Log::info('No studios found with CAP filter, trying all active studios');
                $studios = \Modules\SaluteOra\Models\Studio::where('active', true)
                    ->with(['address', 'doctors'])
                    ->limit(5) // Limitiamo per sicurezza
                    ->get();
            }
            
            // Debug: log dei risultati
            Log::info('Studios found for location (full)', [
                'cap' => $cap,
                'province' => $province, 
                'region' => $region,
                'studios_count' => $studios->count(),
                'studios_with_doctors' => $studios->filter(function($studio) {
                    return $studio->doctors && $studio->doctors->count() > 0;
                })->count()
            ]);
           
            return $studios;
            
        } catch (\Exception $e) {
            Log::error('Error fetching full studios for location: ' . $e->getMessage(), [
                'cap' => $cap,
                'province' => $province,
                'region' => $region,
                'trace' => $e->getTraceAsString()
            ]);
            
            return new \Illuminate\Database\Eloquent\Collection();
        }
    }

    /**
     * Metodo Livewire per selezionare uno studio.
     *
     * @param int $studioId
     * @return void
     */
    public function selectStudio(int $studioId): void
    {
        $studio = \Modules\SaluteOra\Models\Studio::find($studioId);
        if ($studio) {
            $this->data['selected_studio'] = $studioId;
            $this->data['selected_studio_name'] = $studio->name;
        }
    }

